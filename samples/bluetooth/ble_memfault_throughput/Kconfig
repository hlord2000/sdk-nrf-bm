menu "Bluetooth LE Memfault throughput sample"

config SAMPLE_BLE_DEVICE_NAME
	string "Device name"
	default "nRF_BM_TPUT"

config SAMPLE_BLE_MEMFAULT_THROUGHPUT_AUTOSTART
	bool "Start throughput automatically when notifications are enabled"
	help
	  Start the peripheral-to-central notification throughput run as soon as
	  the central enables notifications on the NUS TX characteristic.

config SAMPLE_BLE_MEMFAULT_THROUGHPUT_REPORT_INTERVAL_MS
	int "Throughput report interval in milliseconds"
	default 1000
	range 100 60000

config SAMPLE_BLE_MEMFAULT_THROUGHPUT_TX_WINDOW
	int "Maximum outstanding notifications"
	default 32
	range 1 32
	help
	  Maximum number of Handle Value Notifications to have queued in the
	  SoftDevice before waiting for BLE_GATTS_EVT_HVN_TX_COMPLETE. The
	  throughput sample defaults to the largest app-side window and lets
	  NRF_ERROR_RESOURCES from sd_ble_gatts_hvx provide stack-side backpressure.

config MEMFAULT_NCS_PROJECT_KEY
	string "Memfault nRF Cloud project key"
	depends on MEMFAULT
	help
	  Project key used by the Memfault MCUmgr group. The full NCS Memfault
	  module defines this symbol for Zephyr samples; sdk-nrf-bm does not pull
	  that module in, so the sample defines the same public knob locally.

module=SAMPLE_BLE_MEMFAULT_THROUGHPUT
module-str=Bluetooth LE Memfault throughput sample
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

endmenu

source "Kconfig.zephyr"
